SEED ?= 1
PASSES ?= 20
PF_DIST ?= 2
PF_BATCH ?= 1
FILLER_STRIDE ?= 4

SUFFIX := s$(SEED)-p$(PASSES)-d$(PF_DIST)-b$(PF_BATCH)-fs$(FILLER_STRIDE)
NAME = prefetchi_bench-$(SUFFIX)
SRCS = main.c
CPPFLAGS += -DSEED=$(SEED) -DPASSES=$(PASSES) -DPF_DIST=$(PF_DIST) -DPF_BATCH=$(PF_BATCH) -DFILLER_STRIDE=$(FILLER_STRIDE)
DST_DIR = $(APP_DIR)/build/$(ARCH)/$(SUFFIX)/

include $(AM_HOME)/Makefile.app

common:
	$(MAKE) PF_BATCH=1 PF_DIST=1
	$(MAKE) PF_BATCH=1 PF_DIST=2
	$(MAKE) PF_BATCH=1 PF_DIST=3
	$(MAKE) PF_BATCH=2 PF_DIST=1
	$(MAKE) PF_BATCH=2 PF_DIST=2
	$(MAKE) PF_BATCH=2 PF_DIST=3
	$(MAKE) PF_BATCH=3 PF_DIST=1
	$(MAKE) PF_BATCH=3 PF_DIST=2
	$(MAKE) PF_BATCH=3 PF_DIST=3
